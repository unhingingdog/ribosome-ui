{
  "name": "ribosome-ui",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build:ocaml": "cd .. && dune build",
    "build:bundle": "rolldown -c rolldown.config.js",
    "build:types": "mkdir -p dist && cp src/index.d.ts dist/index.d.ts",
    "build:dist": "npm run clean && npm run build:ocaml && npm run build:bundle && npm run build:types",
    "build": "npm run build:dist",
    "demo": "npm run build:dist && vite --config demo/vite.config.ts",
    "demo:build": "npm run build:dist && vite build --config demo/vite.config.ts",
    "demo:preview": "vite preview --config demo/vite.config.ts",
    "prepublishOnly": "npm run build",
    "test": "vitest"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.21",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^22.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rolldown": "^1.0.0-rc.16",
    "typescript": "^6.0.3",
    "vite": "^6.4.2",
    "vitest": "latest"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
