{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "types": ["@types/bun"],
    "lib": ["ES2022"],
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["src"]
}
