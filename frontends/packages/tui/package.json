{
  "name": "@ribosome/tui",
  "version": "0.0.0",
  "description": "Terminal UI client for Ribosome UI — @opentui/solid → terminal",
  "type": "module",
  "scripts": {
    "dev": "bun run --preload @opentui/solid/preload src/index.tsx",
    "build": "bun build src/index.tsx --outdir dist --target bun",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentui/core": "^0.5.0",
    "@opentui/solid": "^0.5.0",
    "@ribosome/ui-core": "workspace:*",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.5.0"
  }
}
