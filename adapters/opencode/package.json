{
  "name": "@ribosome/opencode-adapter",
  "version": "0.0.0",
  "description": "Functional harness adapter connecting OpenCode to Ribosome UI server",
  "type": "module",
  "main": "./dist/src/entry.js",
  "scripts": {
    "test": "vitest run --exclude test/integration.test.ts",
    "test:integration": "dune build @all && vitest run test/integration.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "postinstall": "bash scripts/install-skills.sh"
  },
  "dependencies": {
    "@opencode-ai/plugin": "*",
    "@opencode-ai/sdk": "*",
    "effect": "^3.0.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
