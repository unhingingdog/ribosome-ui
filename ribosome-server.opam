opam-version: "2.0"
synopsis:
  "MCP control, harness stream, and WebSocket UI transport for Ribosome"
description:
  "ribosome-server implements a minimal MCP subset over stdio, the harness streaming protocol, and Dream WebSocket UI transport. It bridges agent harnesses to the Ribosome core pipeline."
depends: [
  "dune" {>= "3.18"}
  "ocaml" {>= "5.2"}
  "ribosome"
  "yojson"
  "lwt"
  "dream"
  "cmdliner"
  "alcotest" {with-test & >= "1.8.0"}
  "alcotest-lwt" {with-test & >= "1.8.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
